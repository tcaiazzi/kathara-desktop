{
  "name": "kathara-desktop",
  "productName": "Kathara Desktop",
  "version": "0.1.4",
  "private": true,
  "description": "A native desktop app for Kathara.",
  "license": "GPL-3.0",
  "author": {
    "name": "Kathara Framework",
    "email": "tommaso@kathara.org"
  },
  "main": "build/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:shell": "node scripts/build.mjs",
    "build:frontend": "npm --prefix ../frontend run build",
    "build": "npm run typecheck && npm run build:shell",
    "start": "npm run build:shell && node scripts/start.mjs",
    "dist": "npm run build:frontend && npm run build && electron-builder --config electron-builder.yml",
    "dist:linux": "npm run dist -- --linux",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "dist:linux:appimage": "npm run dist -- --linux AppImage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.4"
  },
  "homepage": "https://www.kathara.org/",
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
